{
  "info": {
    "name": "Oracle API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Generate Video",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/videos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"caption\": \"Hello world\",\n  \"background_url\": \"https://example.com/bg.mp4\"\n}"
        }
      }
    },
    {
      "name": "List Payments",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/payments"
      }
    }
  ]
}
